# Supabase Postgres — use the connection pooler URL (transaction mode, port 6543).
# Supabase dashboard → Project Settings → Database → Connection string → "Transaction".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Anthropic — powers design analysis, scoring, prompt building.
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-opus-4-8). e.g. claude-sonnet-5 for lower latency.
SENTINEL_MODEL=claude-opus-4-8

# Optional: OpenAI key enables vector (semantic) retrieval via text-embedding-3-small.
# Without it, Sentinel falls back to keyword search — everything still works.
OPENAI_API_KEY=

# Shared secret for the MCP server and REST API.
# Clients send: Authorization: Bearer <SENTINEL_API_KEY>
# Leave empty for local development only — never in production.
SENTINEL_API_KEY=

# Optional: HTTP Basic auth on the dashboard (username "sentinel"). Empty = open dashboard.
SENTINEL_DASHBOARD_PASSWORD=
